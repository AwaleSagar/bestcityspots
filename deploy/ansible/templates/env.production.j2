# MANAGED BY ANSIBLE — do not edit on the host. Rendered from group_vars/vault.yml.
# Mode 0600, owned by the deploy user. Paid-provider keys are runtime-only
# (never baked into the image — see Dockerfile / incident action P4).

# ── Supabase (data + image storage) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL={{ vault_supabase_url }}
NEXT_PUBLIC_SUPABASE_ANON_KEY={{ vault_supabase_anon_key }}
SUPABASE_SERVICE_ROLE_KEY={{ vault_supabase_service_role_key }}

# ── Paid providers (keys present, but live fetch gated by the flags below) ─
GOOGLE_PLACES_API_KEY={{ vault_google_places_api_key | default('') }}
GOOGLE_GEMINI_API_KEY={{ vault_google_gemini_api_key | default('') }}
OPENAI_API_KEY={{ vault_openai_api_key | default('') }}
OPENWEATHERMAP_API_KEY={{ vault_openweathermap_api_key | default('') }}
AI_PROVIDER={{ ai_provider | default('openai') }}

# ── Cost guardrails (kill switches + daily envelopes) ─────────────────────
# Production default is cache-only. Live fetch requires -e allow_live_fetch=true.
GOOGLE_PLACES_LIVE_FETCH_ENABLED={{ places_live_fetch }}
GOOGLE_GEMINI_LIVE_FETCH_ENABLED={{ gemini_live_fetch }}
GOOGLE_PLACES_DAILY_CALL_LIMIT={{ places_daily_limit }}
GOOGLE_GEMINI_DAILY_CALL_LIMIT={{ gemini_daily_limit }}
# Visitor-triggered AI generation (/api/cities/insight). Claimed on top of
# the engine budget so a crawler or attacker cannot drain the day's spend
# and starve the warmer (security audit M-2).
AI_ON_DEMAND_DAILY_CALL_LIMIT={{ ai_on_demand_daily_limit }}
WARM_CACHE_PLACES_BUDGET={{ warm_places_budget }}
WARM_CACHE_GEMINI_BUDGET={{ warm_gemini_budget }}

# ── Site / ops ────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL={{ vault_site_url }}
LOG_LEVEL={{ log_level | default('info') }}
HEALTH_CHECK_TOKEN={{ vault_health_check_token | default('') }}
NEXT_PUBLIC_CONTACT_EMAIL={{ vault_contact_email | default('') }}
