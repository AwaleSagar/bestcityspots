# MANAGED BY ANSIBLE — proxy snippet included by the site config.
# Matches the contract documented in deploy/nginx/bestcityspots.conf.
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
proxy_set_header X-Forwarded-Proto $scheme;
# SECURITY (audit M-3): clear any client-supplied edge geo headers. The app
# reads x-vercel-ip-country / x-vercel-ip-city for visitor geography; those are
# only trustworthy when Vercel's edge sets them. Behind this proxy a client
# could otherwise forge them. Empty value = header not forwarded upstream.
proxy_set_header X-Vercel-IP-Country "";
proxy_set_header X-Vercel-IP-City "";
proxy_set_header X-Vercel-IP-Country-Region "";
proxy_set_header X-Vercel-IP-Latitude "";
proxy_set_header X-Vercel-IP-Longitude "";
proxy_read_timeout 30s;
proxy_connect_timeout 5s;
