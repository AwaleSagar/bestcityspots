{
  "name": "bestcityspots",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "type-check": "tsc --noEmit",
    "test:refactor": "tsx scripts/verify-refactor.ts",
    "test:google-places": "tsx test-google-places.ts",
    "test:supabase": "tsx scripts/test-supabase-backend.ts",
    "test:supabase:json": "tsx scripts/test-supabase-backend.ts --json",
    "warm-cache": "tsx scripts/warm-cache.ts",
    "warm-cache:trending": "tsx scripts/warm-cache.ts --trending-only",
    "warm-cache:dry-run": "tsx scripts/warm-cache.ts --dry-run",
    "analytics": "tsx scripts/analytics-report.ts",
    "analytics:30d": "tsx scripts/analytics-report.ts --days 30",
    "analytics:json": "tsx scripts/analytics-report.ts --json"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@supabase/supabase-js": "^2.90.1",
    "blurhash": "^2.0.5",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.25.0",
    "lucide-react": "^0.562.0",
    "next": "16.1.1",
    "next-themes": "^0.4.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "server-only": "^0.0.1",
    "sharp": "^0.34.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sharp": "^0.31.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-security": "^3.0.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
