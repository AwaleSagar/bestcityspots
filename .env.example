# Best City Spots — environment template.
#
#   cp .env.example .env.local     # local development (gitignored)
#
# Production reads .env.production (rendered by Ansible from
# deploy/ansible/templates/env.production.j2). Empty values count as unset.
# Everything is optional: the app builds and renders with nothing set and
# degrades to empty/cached states — but without Supabase there is no data.

# ── Supabase ─────────────────────────────────────────────────────────────────
# Local stack: `npm run db:start` prints all three values (API URL,
# Publishable key, Secret key). Hosted: Dashboard → Project Settings →
# API Keys → "Publishable and secret API keys".
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Browser-safe; RLS decides what it can read. Format: sb_publishable_…
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY — bypasses RLS. Never prefix with NEXT_PUBLIC_. Format: sb_secret_…
SUPABASE_SECRET_KEY=

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Comma-separated brand/social URLs for Organization JSON-LD `sameAs`.
NEXT_PUBLIC_ORGANIZATION_SAME_AS=
# Booking.com partner id; affiliate links render only when set.
NEXT_PUBLIC_BOOKING_AFFILIATE_ID=
# Set to "true" to send analytics from `next dev`.
NEXT_PUBLIC_ANALYTICS_DEV=

# ── Providers (server only) ──────────────────────────────────────────────────
# Places results are served from cache only when this key is present.
GOOGLE_PLACES_API_KEY=
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=
OPENWEATHERMAP_API_KEY=
# "gemini" (default) or "openai"; the other becomes the fallback.
AI_PROVIDER=

# ── Cost guard (server only) ─────────────────────────────────────────────────
# Kill switches. Unset = on in development, OFF in production (cache-only).
GOOGLE_PLACES_LIVE_FETCH_ENABLED=
GOOGLE_GEMINI_LIVE_FETCH_ENABLED=
OPENAI_LIVE_FETCH_ENABLED=
# Durable daily call caps (claimed atomically in public.provider_daily_usage).
# Defaults: places 100 / AI 25 in production, 1000 / 500 otherwise.
GOOGLE_PLACES_DAILY_CALL_LIMIT=
GOOGLE_GEMINI_DAILY_CALL_LIMIT=
OPENAI_DAILY_CALL_LIMIT=
# Visitor-triggered AI briefings, on top of the engine budget (default 5 / 100).
AI_ON_DEMAND_DAILY_CALL_LIMIT=

# ── Cache warmers (scripts/warm-*.ts) ────────────────────────────────────────
WARM_CACHE_PLACES_BUDGET=
WARM_CACHE_GEMINI_BUDGET=
WARM_TOP_PLACES_BUDGET=
WARM_TOP_GEMINI_BUDGET=
WARM_TOP_OPENAI_BUDGET=

# ── Operations ───────────────────────────────────────────────────────────────
# ≥16 chars. `Authorization: Bearer <token>` unlocks the detailed /api/health.
HEALTH_CHECK_TOKEN=
# debug | info | warn | error (default: info in production, debug otherwise)
LOG_LEVEL=
